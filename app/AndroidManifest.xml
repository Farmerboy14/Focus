<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.caleb.focus">
  <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34"/>
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
  <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
  <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.SET_WALLPAPER"/>
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <application android:name=".App" android:label="Focus" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
      android:theme="@style/Focus" android:allowBackup="false" android:supportsRtl="true">
    <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask" android:stateNotNeeded="true"
        android:clearTaskOnLaunch="true" android:excludeFromRecents="true" android:screenOrientation="portrait" android:windowSoftInputMode="adjustPan">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.HOME"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
    <activity android:name=".GodActivity" android:exported="false" android:screenOrientation="portrait"/>
    <activity android:name=".BibleActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize"/>
    <activity android:name=".JournalActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize"/>
    <activity android:name=".RestActivity" android:exported="false" android:screenOrientation="portrait"/>
    <activity android:name=".AppsActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize"/>
    <activity android:name=".ScheduleActivity" android:exported="false" android:screenOrientation="portrait"/>
    <activity android:name=".PresetsActivity" android:exported="false" android:screenOrientation="portrait"/>
    <activity android:name=".PresetEditActivity" android:exported="false" android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize"/>
    <activity android:name=".SetupActivity" android:exported="false" android:screenOrientation="portrait"/>
    <activity android:name=".EarthActivity" android:exported="false" android:screenOrientation="portrait"/>
    <activity android:name=".BlockedActivity" android:exported="false" android:screenOrientation="portrait" android:excludeFromRecents="true"
        android:taskAffinity="com.caleb.focus.blocked" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize"/>
    <activity android:name=".LockActivity" android:exported="false" android:showWhenLocked="true" android:excludeFromRecents="true"
        android:launchMode="singleInstance" android:taskAffinity="com.caleb.focus.lock" android:screenOrientation="portrait"/>
    <activity android:name=".SendToPcActivity" android:exported="true" android:label="Send to PC"
        android:theme="@android:style/Theme.Translucent.NoTitleBar" android:excludeFromRecents="true"
        android:taskAffinity="com.caleb.focus.send" android:noHistory="true">
      <intent-filter>
        <action android:name="android.intent.action.SEND"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="text/plain"/>
      </intent-filter>
    </activity>
    <service android:name=".ClipTileService" android:exported="true" android:label="Clipboard to PC"
        android:icon="@mipmap/ic_launcher" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
    </service>
    <receiver android:name=".Updater$Receiver" android:exported="false">
      <intent-filter><action android:name="com.caleb.focus.INSTALL_STATUS"/></intent-filter>
    </receiver>
    <service android:name=".FocusService" android:exported="true" android:label="Focus app blocking"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/focus_service"/>
    </service>
  </application>
</manifest>

{
  "name": "focus-pc",
  "productName": "Focus",
  "version": "1.0.0",
  "description": "Focus for Windows: the desktop companion to Focus on the phone.",
  "main": "bootstrap.js",
  "private": true,
  "author": "Caleb",
  "scripts": {
    "test": "node test/run-all.js",
    "test:e2e": "xvfb-run -a node test/e2e.js",
    "test:extension": "xvfb-run -a node test/extension.js",
    "screens": "node test/screens.js",
    "package": "bash build-win.sh",
    "test:desktop": "xvfb-run -a electron --no-sandbox --use-angle=swiftshader --enable-unsafe-swiftshader test/desktop-electron.js",
    "test:phone": "xvfb-run -a electron --no-sandbox --disable-gpu test/phone-electron.js",
    "test:notes": "xvfb-run -a node test/notes-upgrade-e2e.js"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "@electron/packager": "20.3.0"
  }
}
